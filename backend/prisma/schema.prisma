// Prisma Schema for NextERP & Inventory Core

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum POStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum SOStatus {
  PENDING
  ALLOCATED
  INVOICED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

// ------------------------------------------------------
// RBAC & USERS
// ------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String          @map("password_hash")
  roleId       String          @map("role_id")
  role         Role            @relation(fields: [roleId], references: [id])
  auditLogs    AuditLog[]
  transfers    StockTransfer[]
  payments     Payment[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

// ------------------------------------------------------
// MASTER DATA
// ------------------------------------------------------

model Warehouse {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  address           String?
  inventories       Inventory[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  salesOrders       SalesOrder[]
  transfersSent     StockTransfer[] @relation("FromWarehouse")
  transfersReceived StockTransfer[] @relation("ToWarehouse")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@map("warehouses")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id                 String              @id @default(uuid())
  sku                String              @unique
  barcode            String?             @unique
  name               String
  unit               String              @default("Pcs")
  categoryId         String              @map("category_id")
  category           Category            @relation(fields: [categoryId], references: [id])
  minStock           Int                 @default(0) @map("min_stock")
  buyPrice           Decimal             @map("buy_price") @db.Decimal(12, 2)
  sellPrice          Decimal             @map("sell_price") @db.Decimal(12, 2)
  inventories        Inventory[]
  stockMovements     StockMovement[]
  transferItems      StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("products")
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  email          String?
  phone          String?
  address        String?
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
}

model Customer {
  id          String       @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  salesOrders SalesOrder[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("customers")
}

// ------------------------------------------------------
// INVENTORY, MOVEMENTS & TRANSFERS
// ------------------------------------------------------

model Inventory {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  warehouseId String    @map("warehouse_id")
  quantity    Int       @default(0)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([productId, warehouseId])
  @@map("inventories")
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String            @map("product_id")
  warehouseId String            @map("warehouse_id")
  type        StockMovementType
  quantity    Int
  referenceId String?           @map("reference_id")
  product     Product           @relation(fields: [productId], references: [id])
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("stock_movements")
}

model StockTransfer {
  id              String              @id @default(uuid())
  transferNumber  String              @unique @map("transfer_number")
  fromWarehouseId String              @map("from_warehouse_id")
  toWarehouseId   String              @map("to_warehouse_id")
  status          TransferStatus      @default(DRAFT)
  notes           String?
  createdById     String?             @map("created_by_id")
  fromWarehouse   Warehouse           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items           StockTransferItem[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String        @map("transfer_id")
  productId  String        @map("product_id")
  quantity   Int
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])

  @@map("stock_transfer_items")
}

// ------------------------------------------------------
// PURCHASING & SALES
// ------------------------------------------------------

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique @map("po_number")
  supplierId  String              @map("supplier_id")
  warehouseId String              @map("warehouse_id")
  status      POStatus            @default(DRAFT)
  totalAmount Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String        @id @default(uuid())
  poId          String        @map("po_id")
  productId     String        @map("product_id")
  quantity      Int
  unitPrice     Decimal       @map("unit_price") @db.Decimal(12, 2)
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model SalesOrder {
  id          String           @id @default(uuid())
  soNumber    String           @unique @map("so_number")
  customerId  String           @map("customer_id")
  warehouseId String           @map("warehouse_id")
  status      SOStatus         @default(PENDING)
  totalAmount Decimal          @default(0) @map("total_amount") @db.Decimal(12, 2)
  customer    Customer         @relation(fields: [customerId], references: [id])
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  items       SalesOrderItem[]
  invoice     Invoice?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("sales_orders")
}

model SalesOrderItem {
  id         String     @id @default(uuid())
  soId       String     @map("so_id")
  productId  String     @map("product_id")
  quantity   Int
  unitPrice  Decimal    @map("unit_price") @db.Decimal(12, 2)
  salesOrder SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  salesOrderId  String        @unique @map("sales_order_id")
  status        InvoiceStatus @default(UNPAID)
  dueDate       DateTime?     @map("due_date")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id])
  payments      Payment[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

// Riwayat pembayaran invoice (Fase 5) — status OVERDUE dihitung on-read
// (dueDate lewat & belum lunas), bukan disimpan, sehingga tanpa cron job.
model Payment {
  id         String   @id @default(uuid())
  invoiceId  String   @map("invoice_id")
  amount     Decimal  @db.Decimal(12, 2)
  paidAt     DateTime @default(now()) @map("paid_at")
  method     String?
  note       String?
  recordedBy String?  @map("recorded_by")
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [recordedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("payments")
}

// ------------------------------------------------------
// AUDIT LOGS
// ------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
